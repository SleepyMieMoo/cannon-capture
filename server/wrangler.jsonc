{
  // Cannon Capture online server (see README: "Online player vs player").
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cannon-capture-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  // The free plan needs SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://sleepymiemoo.github.io,http://localhost:*,http://127.0.0.1:*"
  }
}
